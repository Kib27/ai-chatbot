    {
      "parameters": {
        "jsCode": "\n// Ambil semua data dari node sebelumnya\nconst items = $input.all();\n\n// Variabel untuk menghitung sentimen\nlet positive = 0;\nlet negative = 0;\nlet neutral = 0;\nlet total = 0;\n\n// Loop setiap baris data\nfor (const item of items) {\n  const sentiment = String(item.json.Sentiment || '').trim().toLowerCase();\n\n  if (sentiment === 'positive') {\n    positive++;\n  } else if (sentiment === 'negative') {\n    negative++;\n  } else if (sentiment === 'neutral') {\n    neutral++;\n  }\n\n  if (sentiment !== '') {\n    total++;\n  }\n}\n\n// Hitung persentase\nconst positivePercent = total ? (positive / total * 100).toFixed(2) : 0;\nconst negativePercent = total ? (negative / total * 100).toFixed(2) : 0;\nconst neutralPercent = total ? (neutral / total * 100).toFixed(2) : 0;\n\n// Tampilkan hasil analisis\nreturn [\n  {\n    json: {\n      total_berita: total,\n      positive: positive,\n      negative: negative,\n      neutral: neutral,\n      positive_percent: positivePercent,\n      negative_percent: negativePercent,\n      neutral_percent: neutralPercent\n    }\n  }\n];\n"
      },
