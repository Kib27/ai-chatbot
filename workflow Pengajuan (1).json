    {
      "parameters": {
        "jsCode": "// 1. Ambil data karyawan dari node Google Sheets (hasil lookup berdasarkan email)\nconst employeeData = items[0].json;\n\n// 2. Ambil data dari node Form (nama node harus SAMA PERSIS)\nconst formData = $('Formulir pengajuan Cuti').first().json;\n\n// 3. Hitung durasi cuti dengan Luxon (inklusif: selisih hari + 1)\nconst start = DateTime.fromISO(formData[\"Tanggal Mulai\"]);\nconst end = DateTime.fromISO(formData[\"Tanggal Selesai\"]);\nconst durationInDays = end.diff(start, 'days').days + 1;\n\n// 4. Validasi: tanggal harus valid DAN saldo mencukupi\nconst isDateValid = durationInDays >= 1;\nconst currentBalance = parseInt(employeeData[\"Saldo_Cuti\"]);\nconst hasEnoughBalance = isDateValid && currentBalance >= durationInDays;\n\n// 5. ID unik untuk setiap pengajuan\nconst uniqueId = 'REQ-' + Date.now();\n\nreturn [\n  {\n    json: {\n      ...employeeData,\n      ...formData,\n      durationRequested: durationInDays,\n      isApprovedSystem: hasEnoughBalance,\n      message: !isDateValid ? \"Tanggal Tidak Valid\" : (hasEnoughBalance ? \"Saldo Cukup\" : \"Saldo Tidak Cukup\"),\n      requestId: uniqueId\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
